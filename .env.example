# Copy to .env (or run ./setup.sh, which asks for each key). Never commit .env.
# Empty = that feature is off; everything else still runs.

# Voice: ElevenLabs TTS with word timestamps, through fal.ai (required to make videos)
FAL_API_KEY=

# Generated props and scenes (kie.ai, about 0.03 USD per image)
KIE_API_KEY=

# Gemini video analysis of competitors (OpenRouter) - used by channel-style and research
OPENROUTER_API_KEY=

# Free stock photos and footage
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: identifies the media fetcher to Wikimedia (generic is fine)
# EXPLAINER_UA=explainer-kit/0.1 (+https://www.mediawiki.org/wiki/API:Etiquette)
